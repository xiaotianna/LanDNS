{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanDNS",
  "version": "1.1.1",
  "identifier": "app.dnsx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "LanDNS",
      "width": 1180,
      "height": 800,
      "minWidth": 860,
      "minHeight": 640,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "category": "DeveloperTool",
    "shortDescription": "A local network DNS and reverse proxy utility",
    "macOS": { "minimumSystemVersion": "14.0", "infoPlist": "Info.plist" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExODlCOUY4MzBDMzREN0UKUldSK1RjTXcrTG1Kb2JJSnJuN2x5R2ExZzNPSWZJR2xBM0pZQk4rY3h6YStxOFYrbFNzYnFvQzAK",
      "endpoints": ["https://github.com/xiaotianna/LanDNS/releases/latest/download/latest.json"]
    }
  }
}
